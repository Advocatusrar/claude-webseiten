# Copy to /opt/website/.env on the server and fill in. Never commit the real .env.

# Main address of the site, without https:// (must match the repository variable SITE_URL).
DOMAIN=www.meine-domain.de
# Optional second name that redirects to DOMAIN, e.g. the domain without www.
REDIRECT_DOMAIN=meine-domain.de

# E-mail address for Let's Encrypt (account and important notices).
ACME_EMAIL=admin@meine-domain.de

# For the very first test the staging CA avoids Let's Encrypt rate limits (browser shows a
# certificate warning). Remove the line afterwards and delete the volume website_letsencrypt.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Set by deploy.sh on every deploy (image from the CI, pinned by digest).
WEBSITE_IMAGE=ghcr.io/OWNER/REPO/website:latest

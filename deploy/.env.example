# Copy to /opt/website/.env on the server and fill in. Never commit the real .env.
# Two variants, see docs/server.md:
#   A) own Traefik:      compose.yml + traefik/dynamic.yml (default, no COMPOSE_FILE)
#   B) Hostinger VPS:    compose.hostinger.yml, attaches to the Traefik managed by Hostinger

# Variant B only: makes plain `docker compose` (and deploy.sh) use the Hostinger file.
# Leave the line out for variant A.
# COMPOSE_FILE=compose.hostinger.yml

# Main address of the site, without https:// (must match the repository variable SITE_URL).
# Variant B (funkenundstahl.de): DOMAIN=funkenundstahl.de
DOMAIN=www.meine-domain.de
# Second name that redirects permanently to DOMAIN (path and query are kept).
# Optional in variant A, required in variant B.
# Variant B (funkenundstahl.de): REDIRECT_DOMAIN=www.funkenundstahl.de
REDIRECT_DOMAIN=meine-domain.de

# Variant A only: e-mail address for Let's Encrypt (account and important notices).
# Not needed in variant B, the Traefik managed by Hostinger requests the certificates.
ACME_EMAIL=admin@meine-domain.de

# Variant A only: for the very first test the staging CA avoids Let's Encrypt rate limits
# (browser shows a certificate warning). Remove the line afterwards and delete the volume
# website_letsencrypt.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Both variants: set by deploy.sh on every deploy (image from the CI, pinned by digest).
WEBSITE_IMAGE=ghcr.io/OWNER/REPO/website:latest

---
// Renders Markdown content (slot) and shifts its headings so the page keeps exactly
// one H1 and a gap-free heading order, no matter at which level a text starts.
// Example: <Ueberschriften ab={3}><Content /></Ueberschriften> turns a leading H1 or H2 into H3.
// Works with any Markdown processor (Astro 7 uses Sätteri, which takes no rehype plugins).
// With `artikel`, links to articles that are not in the list (drafts, not yet written)
// become plain text marked "(Artikel folgt)"; the rule lives in src/lib/verweise.ts and
// is shared with the Markdown version. Tables get a named scroll region, a caption
// (from a paragraph "Tabelle: …" directly before the table), scope="col" on the header
// cells and data-label on every cell, so they can be stacked on small screens.
import { htmlOhneFehlendeArtikel } from '../lib/verweise';

interface Props {
  /** Level the highest heading of the content should get (2 to 6). */
  ab: 2 | 3 | 4 | 5 | 6;
  /** Ids of published articles. Links to other articles under /blog/ become plain text. */
  artikel?: string[];
}
const { ab, artikel } = Astro.props;
const roh = await Astro.slots.render('default');
const seitenUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const verlinkt = artikel ? htmlOhneFehlendeArtikel(roh, seitenUrl, artikel) : roh;

const nurText = (html: string) =>
  html
    .replace(/<[^>]*>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
const alsAttribut = (text: string) =>
  text
    .replace(/&(?![a-z0-9#]+;)/gi, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;');

let nummer = 0;
const tabellen = verlinkt.replace(
  /(?:<p>Tabelle:\s*((?:(?!<\/p>)[\s\S])*)<\/p>\s*)?<table>([\s\S]*?)<\/table>/g,
  (_, titel: string | undefined, inhalt: string, pos: number, ganz: string) => {
    nummer += 1;
    const id = `md-tabelle-${nummer}`;
    const spalten: string[] = [];
    let ergebnis = inhalt.replace(/<thead>([\s\S]*?)<\/thead>/, (kopf: string) =>
      kopf.replace(/<th\b([^>]*)>([\s\S]*?)<\/th>/g, (zelle: string, attrs: string, text: string) => {
        spalten.push(nurText(text));
        return /\sscope=/.test(attrs) ? zelle : `<th scope="col"${attrs}>${text}</th>`;
      }),
    );
    ergebnis = ergebnis.replace(/<tbody>([\s\S]*?)<\/tbody>/, (koerper: string) =>
      koerper.replace(/<tr>([\s\S]*?)<\/tr>/g, (_z: string, zeile: string) => {
        let spalte = 0;
        const mitLabels = zeile.replace(/<(td|th)\b([^>]*)>/g, (tag: string, name: string, attrs: string) => {
          const label = spalten[spalte];
          spalte += 1;
          return name === 'td' && label && !/\sdata-label=/.test(attrs)
            ? `<td data-label="${alsAttribut(label)}"${attrs}>`
            : tag;
        });
        return `<tr>${mitLabels}</tr>`;
      }),
    );
    let name: string;
    let caption = '';
    if (titel && nurText(titel)) {
      caption = `<caption id="${id}"><span class="caption-text">${titel.trim()}</span></caption>`;
      name = `aria-labelledby="${id}"`;
    } else {
      // Without a caption the region is named after the nearest heading before the table.
      const vorher = [...ganz.slice(0, pos).matchAll(/<h[1-6]\b[^>]*>([\s\S]*?)<\/h[1-6]>/g)].pop();
      const ueberschrift = vorher ? nurText(vorher[1]) : '';
      name = `aria-label="${alsAttribut(ueberschrift ? `Tabelle: ${ueberschrift}` : `Tabelle ${nummer}`)}"`;
    }
    return `<div class="tabelle-scroll tabelle-stapel" tabindex="0" role="region" ${name}><table>${caption}${ergebnis}</table></div>`;
  },
);

const ebenen = [...tabellen.matchAll(/<h([1-6])(?=[\s>])/g)].map((m) => Number(m[1]));
const verschiebung = ebenen.length > 0 ? Math.max(0, ab - Math.min(...ebenen)) : 0;
const ergebnis =
  verschiebung === 0
    ? tabellen
    : tabellen.replace(
        /<(\/?)h([1-6])(?=[\s>])/g,
        (_, schraeg: string, n: string) => `<${schraeg}h${Math.min(6, Number(n) + verschiebung)}`,
      );
---

<Fragment set:html={ergebnis} />

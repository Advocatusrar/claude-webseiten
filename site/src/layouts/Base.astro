---
// Base layout. Interface (keep stable): title, description, jsonLd (object or array, optional).
// Optional: type ('website' | 'article'), stand (Date of the last content check),
// veroeffentlicht (publication date of an article), noindex.
// Extra <head> tags can be passed with slot="head".
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../site';
import { absoluteUrl, BASE, url } from '../lib/url';
import { VORSCHAUBILD } from '../lib/jsonld';
import { datumIso } from '../lib/format';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  type?: 'website' | 'article';
  stand?: Date;
  veroeffentlicht?: Date;
  noindex?: boolean;
}

const { title, description, jsonLd, type = 'website', stand, veroeffentlicht, noindex = false } = Astro.props;

const pfad = Astro.url.pathname;
const istStartseite = pfad === BASE || `${pfad}/` === BASE;
const seitentitel = istStartseite ? title : `${title} | ${SITE.name}`;
const canonical = new URL(pfad, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121813" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href={url('sitemap-index.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={absoluteUrl(VORSCHAUBILD.pfad)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(VORSCHAUBILD.breite)} />
    <meta property="og:image:height" content={String(VORSCHAUBILD.hoehe)} />
    <meta property="og:image:alt" content={VORSCHAUBILD.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {veroeffentlicht && type === 'article' && (
      <meta property="article:published_time" content={datumIso(veroeffentlicht)} />
    )}
    {stand && type === 'article' && <meta property="article:modified_time" content={datumIso(stand)} />}
    <slot name="head" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">
      Zum Inhalt
    </a>
    <SiteHeader />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <SiteFooter stand={stand} />
  </body>
</html>

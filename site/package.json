{
  "name": "outdoor-feuer-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "check": "node scripts/check-site.mjs",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "test": "vitest run && astro build && node scripts/check-site.mjs && html-validate \"dist/**/*.html\"",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "html-validate": "11.17.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

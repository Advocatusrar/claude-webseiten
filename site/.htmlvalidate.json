{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "attribute-boolean-style": "off",
    "long-title": "off",
    "prefer-native-element": [
      "error",
      {
        "exclude": ["region"]
      }
    ]
  }
}
